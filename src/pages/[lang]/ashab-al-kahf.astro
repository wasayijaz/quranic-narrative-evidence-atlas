---
import AtlasLayout from "../../layouts/AtlasLayout.astro";
import { loadAtlas } from "../../lib/atlas";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ur" } }];
}

const lang = Astro.params.lang === "ur" ? "ur" : "en";
const isUrdu = lang === "ur";
const atlas = await loadAtlas("ashab-al-kahf");
const tabari = atlas.sources.find((source) => source.id === "tabari-jami-al-bayan");
const dossier = atlas.dossiers.find((entry) => entry.id === "ashab-al-kahf") ?? {
  title: { en: "The Companions of the Cave", ur: "?????? ???" },
  description: { en: "", ur: "" },
};
const title = dossier.title[lang];
const description = dossier.description[lang];
const disclosure = dossier.disclosure?.[lang] ?? (isUrdu
  ? "?? ???? ?? ??? ???? ???? ?? ???? ?????? ??????? ????? ??? ?? ??? ?? ???? ????"
  : "Not reviewed by a scholarly board. Corrections are logged publicly.");
const sourceClassLabels = isUrdu
  ? { quran: "????", hadith: "????", tafsir: "?????", history: "?????", academic: "????" }
  : { quran: "Quran", hadith: "Hadith", tafsir: "Tafsir", history: "History", academic: "Academic" };
const statusLabels = isUrdu
  ? { attested: "?????", disputed: "??????", "reported-only": "??? ????? ?????", rejected: "?????" }
  : { attested: "Attested", disputed: "Disputed", "reported-only": "Reported only", rejected: "Rejected" };
const publishedClaims = atlas.publishedClaims.map((claim) => ({
  claim,
  result: atlas.resultByClaim.get(claim.id),
  sources: claim.attributions.map((attribution) => ({
    attribution,
    source: atlas.sources.find((candidate) => candidate.id === attribution.source),
    row: atlas.ledgerRows.find(
      (candidate) =>
        candidate.claim === claim.id &&
        candidate.source === attribution.source &&
        candidate.edition === attribution.edition &&
        !candidate.superseded_by,
    ),
  })),
}));
const withheldCount = atlas.summary.unlocated + atlas.summary.blocked;
const copy = isUrdu
  ? {
      eyebrow: "?????? ???",
      intro: "??? ??????? ???? ?? ????? ???? ?????",
      lead: "?? ???? ?????? ??? ?? ???? ?? ???? ???? ??? ?? ???? ????? ???? ???? ??? ?????? ???? ?????",
      read: "????? ???? ????? ????? ??? ????",
      readBody: "???? ???? ?? ????? ?????? ????? ??? ??? ?????? ???? ??? located: no ??? ?? ??? ??? ???? ??? ??? ??? ???",
      evidence: "????? ????",
      evidenceBody: "???? ??? ??? ??? ???? ?? ??? ???? ??? ??? ?????? ??? ???? ????",
      source: "????",
      edition: "???? ?????? ??????",
      page: "???? 64",
      status: "???? ??? ????",
      verify: "???? ?? ?????? ??????",
      sourceNote: "???? 64 ?? ??????? ????? ??? ???? ?? ??? ???? ?? ???? ???? ???? ???",
    }
  : {
      eyebrow: "ASHAB AL-KAHF",
      intro: "A story held open to the page.",
      lead: "This first reading begins with one claim. What has not been checked stays out of the published prose.",
      read: "The claim is withheld",
      readBody: "The first source record exists, but its ledger row is still marked located: no. The statement therefore remains outside the rendered reading.",
      evidence: "Source mark",
      evidenceBody: "Only what a reader can turn to in the named edition is allowed to become visible prose.",
      source: "al-Tabari",
      edition: "Bulaq / Amiriyya edition",
      page: "page 64",
      status: "not yet located",
      verify: "Open the verification ledger",
      sourceNote: "Candidate scan page 64 is recorded; owner verification is still required.",
    };
---

<AtlasLayout
  lang={lang}
  title={title}
  description={description}
  current="dossier"
  disclosure={disclosure}
  disclosureLinkLabel={isUrdu ? "?????? ??????" : "Public correction log"}
>
  <section class="hero-section">
    <div class="hero-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.intro}</h1>
      <p class="hero-lead">{copy.lead}</p>
      <div class="hero-actions">
        <a class="button button-dark" href={`/${lang}/verification`}>{copy.verify}</a>
        <a class="text-link" href="#evidence">{copy.evidence} <span aria-hidden="true">?</span></a>
      </div>
    </div>
    <aside class="hero-orbit" aria-label={isUrdu ? "?????" : "Reading status"}>
      <div class="orbit-ring orbit-ring-one"></div>
      <div class="orbit-ring orbit-ring-two"></div>
      <div class="orbit-card">
        <span class="orbit-number">{String(atlas.summary.total).padStart(2, "0")}</span>
        <span>{isUrdu ? "????? ?????? ???" : "claim in the ledger"}</span>
        <strong>{withheldCount} {isUrdu ? "???? ?? ?????" : "awaiting verification"}</strong>
      </div>
    </aside>
  </section>

  <section id="evidence" class="evidence-section" aria-labelledby="evidence-title">
    <div class="section-heading">
      <p class="eyebrow">{copy.evidence}</p>
      <h2 id="evidence-title">{isUrdu ? "????? ?? ????? ????" : "Before the claim, the source."}</h2>
      <p>{copy.evidenceBody}</p>
    </div>

    <div class="evidence-grid">
      <article class="evidence-card evidence-card-wide">
        <div class="card-topline"><span>{copy.source}</span><span>{copy.status}</span></div>
        <h3>{tabari?.work_title_en}</h3>
        <p>{tabari?.author}</p>
        <div class="source-ribbon" aria-label={isUrdu ? "?????? ?? ?????" : "Edition details"}>
          <span>{copy.edition}</span><span>{copy.page}</span><span>archive.org</span>
        </div>
      </article>
      <article class="evidence-card evidence-card-narrow">
        <p class="card-index">{isUrdu ? "???? ??" : "A clear boundary"}</p>
        <h3>{isUrdu ? "??? ????? ??? ???? ???? ???? ?????" : "Unchecked text does not become published prose."}</h3>
        <p>{copy.sourceNote}</p>
      </article>
    </div>
  </section>

  {publishedClaims.length > 0 && (
    <section class="published-section" aria-labelledby="published-title">
      <div class="section-heading">
        <p class="eyebrow">{isUrdu ? "????? ??? ???" : "Gate-safe reading"}</p>
        <h2 id="published-title">
          {isUrdu ? "?? ???? ???? ?? ???? ??? ????" : "What has made it through the page check."}
        </h2>
        <p>
          {isUrdu
            ? "???? ??? ?? ???? ?????? ???? ??? ?? ?? ????? ???? ???? ?? ??? ???"
            : "Only claims whose active ledger rows are complete appear in the reading."}
        </p>
      </div>

      <div class="published-list">
        {publishedClaims.map(({ claim, result, sources }) => (
          <article class="published-card">
            <div class="card-topline">
              <span><bdi>{claim.id}</bdi></span>
              <span>{sourceClassLabels[claim.source_class]}</span>
              <span>{statusLabels[claim.status]}</span>
              <span>{result?.state === "secondary" ? (isUrdu ? "?????" : "secondary") : (isUrdu ? "????" : "verified")}</span>
            </div>
            <h3>{claim.statement[lang]}</h3>
            <div class="published-sources">
              {sources.map(({ attribution, source, row }) => (
                <p>
                  <strong>{source?.work_title_en ?? attribution.source}</strong>
                  <span>{attribution.edition}</span>
                  {attribution.page && <span>{isUrdu ? `???? ${attribution.page}` : `page ${attribution.page}`}</span>}
                  {row?.checked_by && <span>{isUrdu ? `?????: ${row.checked_by}` : `checked by ${row.checked_by}`}</span>}
                </p>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {withheldCount > 0 && (
    <section class="withheld-section" aria-labelledby="withheld-title">
      <div class="withheld-copy">
        <p class="eyebrow">{isUrdu ? "???? ??????" : "The first threshold"}</p>
        <h2 id="withheld-title">
          {publishedClaims.length > 0
            ? (isUrdu ? `${withheldCount} ???? ???? ??? ??? ??? ????` : `${withheldCount} claims remain withheld.`)
            : copy.read}
        </h2>
        <p>
          {publishedClaims.length > 0
            ? (isUrdu
                ? "??? ???? ????? ???? ???? ???? ?????? ???? ???? ???? ???? ?? ???? ???? ????"
                : "Only claims with complete source rows appear in the reading; the rest stay out until checked.")
            : copy.readBody}
        </p>
      </div>
      <div class="withheld-mark" aria-hidden="true">
        <span>?</span>
        <small>{isUrdu ? "????? ??????" : "see the ledger"}</small>
      </div>
    </section>
  )}

  <section class="ledger-callout">
    <p>{isUrdu ? "????? ???? ?? ??????" : "Public verification"}</p>
    <a class="callout-link" href={`/${lang}/verification`}>{copy.verify} <span aria-hidden="true">?</span></a>
  </section>
</AtlasLayout>
