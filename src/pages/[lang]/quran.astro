---
import AtlasLayout from "../../layouts/AtlasLayout.astro";
import { loadAtlas } from "../../lib/atlas";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ur" } }];
}

const lang = Astro.params.lang === "ur" ? "ur" : "en";
const isUrdu = lang === "ur";
const atlas = await loadAtlas("ashab-al-kahf");
const dossier = atlas.dossiers.find((entry) => entry.id === "ashab-al-kahf") ?? {
  title: { en: "The Companions of the Cave", ur: "?????? ???" },
  description: { en: "", ur: "" },
};
const disclosure = dossier.disclosure?.[lang] ?? (isUrdu
  ? "?? ???? ?? ??? ???? ???? ?? ???? ?????? ??????? ????? ??? ?? ??? ?? ???? ????"
  : "Not reviewed by a scholarly board. Corrections are logged publicly.");
const copy = isUrdu
  ? {
      eyebrow: "???? ? ????? ???",
      title: "??? ?? ??? ??? ?? ???????",
      lead: "?? ???? ????? ?????? ???? ???? ????? ?? beat ???? ????? ????? ?? ????? ???? ????? ??? ???? ??? ??? ????? ??? ?????",
      back: "?????? ?????",
      note: "?????? ????? ????",
      noteBody: "???? ??? ??? ??? ???? ?? passage ?? ?????? reader ??? ?????? ??? ?? atlas ??? ??? ???? ????? ???? ???? ??? ????",
      open: "???? ?? ????? ??????",
      research: "????? ??? ??????",
      story: "?????? ????? ??? ??????",
    }
  : {
      eyebrow: "QURAN ? PASSAGE ANCHORS",
      title: "Open each passage where it lives.",
      lead: "This page does not re-publish a translation. Each beat opens its Quran reference directly, keeping the text and later interpretation distinct.",
      back: "Return to the Story Canvas",
      note: "External Quran reader",
      noteBody: "Each link opens the passage in an external reader; no unlicensed translation is embedded in this atlas.",
      open: "Open Quran reference",
      research: "View the evidence desk",
      story: "View in Story Canvas",
    };
---

<AtlasLayout
  lang={lang}
  title={isUrdu ? "???? ? ?????? ???" : "Quran ? Ashab al-Kahf"}
  description={isUrdu ? "?????? ??? ?? ????? ????? ????" : "Quran passage anchors for Ashab al-Kahf."}
  current="quran"
  disclosure={disclosure}
  disclosureLinkLabel={isUrdu ? "????? ???? ?? ??????" : "Public verification ledger"}
>
  <section class="quran-hero">
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="hero-lead">{copy.lead}</p>
      <div class="hero-actions">
        <a class="button button-dark" href={`/${lang}/learn`}>{copy.back}</a>
        <a class="text-link" href={`/${lang}/research`}>{copy.research} <span aria-hidden="true">?</span></a>
      </div>
    </div>
    <aside class="quran-note">
      <p class="panel-kicker">{copy.note}</p>
      <p>{copy.noteBody}</p>
    </aside>
  </section>

  <section class="quran-anchor-section" aria-labelledby="quran-anchor-title">
    <div class="section-heading">
      <p class="eyebrow">{isUrdu ? "????? ????" : "Passage map"}</p>
      <h2 id="quran-anchor-title">{isUrdu ? "?? ????? ???? ??? ?? ?????" : "Every anchor with its place."}</h2>
    </div>
    <div class="quran-anchor-list">
      {atlas.beats.map((beat) => (
        <article class="quran-anchor-row" id={beat.id}>
          <span class="story-preview-order">{String(beat.order).padStart(2, "0")}</span>
          <div>
            <h3>{beat.title[lang]}</h3>
            <p>{beat.summary[lang]}</p>
          </div>
          <div class="quran-anchor-actions">
            <a class="button button-outline" href={beat.quran_link} rel="noreferrer" target="_blank">{beat.ayah_refs.join(" ? ")} <span aria-hidden="true">?</span></a>
            <a class="text-link" href={`/${lang}/learn#${beat.id}`}>{copy.story} <span aria-hidden="true">?</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>
</AtlasLayout>
