      rules: [
        { title: "Quran", body: "A passage reference is its own primary layer." },
        { title: "Reported", body: "Hadith, tafsir, or history arrives with its source and state attached." },
        { title: "Unknown", body: "A page that has not been checked does not become public prose." },
      ],
      finalTitle: "Start with the story.",
      finalBody: "This is one dossier so far; it is no longer only a ledger.",
      finalAction: "Begin reading",
      catalogEyebrow: "Story catalog",
      catalogTitle: "One atlas, more than one way into the Quran.",
      catalogLead: "A new story enters with Quran anchors first. Tafsir and historical layers come only after separate source research.",
      catalogStatus: { "product-slice-foundation": "First product slice", "quran-anchor-only": "Quran anchors only" },
      catalogAction: "Open story",
    };
---

<AtlasLayout
  lang={lang}
  title={isUrdu ? "????? ?????? ?????" : "Quranic Narrative Atlas"}
  description={isUrdu ? "????? ???????? ?? ???? ?? ???? ?????? ?????? ??? ????? ???? ?? ????" : "A source-led place to learn, teach, and research Quranic narratives."}
  current="explore"
  disclosure={disclosure}
  disclosureLinkLabel={isUrdu ? "????? ???? ?? ??????" : "Public verification ledger"}
>
  <section class="explore-hero">
    <div class="explore-hero-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p class="hero-lead">{copy.lead}</p>
      <div class="hero-actions">
        <a class="button button-dark" href={`/${lang}/learn`}>{copy.learn}</a>
        <a class="text-link" href={`/${lang}/research`}>{copy.research} <span aria-hidden="true">?</span></a>
      </div>
    </div>
    <aside class="explore-hero-panel" aria-label={isUrdu ? "???? ??????" : "Featured reading"}>
      <p class="panel-kicker">{copy.panelKicker}</p>
      <h2>{dossier.title[lang]}</h2>
      <p>{copy.panelBody}</p>
      <a class="panel-link" href={`/${lang}/learn`}>{copy.openStory} <span aria-hidden="true">?</span></a>
    </aside>
  </section>

  <section class="intent-section" aria-labelledby="intent-title">
    <div class="section-heading">
      <p class="eyebrow">{copy.waysEyebrow}</p>
      <h2 id="intent-title">{copy.waysTitle}</h2>
      <p>{copy.waysLead}</p>
    </div>
    <div class="intent-grid">
      {copy.intents.map((intent, index) => (
        <a class="intent-card" href={intent.href}>
          <span class="intent-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3>{intent.title}</h3>
            <p>{intent.body}</p>
          </div>
          <span class="intent-action">{intent.action} <span aria-hidden="true">?</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="story-preview-section" aria-labelledby="story-preview-title">
    <div class="story-preview-copy">
      <p class="eyebrow">{copy.storyEyebrow}</p>
      <h2 id="story-preview-title">{copy.storyTitle}</h2>
      <p>{copy.storyLead}</p>
      <a class="button button-outline" href={`/${lang}/learn`}>{copy.openStory}</a>
    </div>
    <div class="story-preview-list">
      {atlas.beats.slice(0, 3).map((beat) => (
        <article class="story-preview-row">
          <span class="story-preview-order">{String(beat.order).padStart(2, "0")}</span>
          <div>
            <h3>{beat.title[lang]}</h3>
            <p>{beat.summary[lang]}</p>
          </div>
          <a href={beat.quran_link} rel="noreferrer" target="_blank">{beat.ayah_refs.join(" ? ")} <span aria-hidden="true">?</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="dossier-catalog-section" aria-labelledby="catalog-title">
    <div class="section-heading">
      <p class="eyebrow">{copy.catalogEyebrow}</p>
      <h2 id="catalog-title">{copy.catalogTitle}</h2>
      <p>{copy.catalogLead}</p>
    </div>
    <div class="dossier-catalog-grid">
      {dossierCatalog.map((entry) => {
        const href = entry.id === "ashab-al-kahf" ? `/${lang}/learn` : `/${lang}/stories/${entry.id}`;
        const status = copy.catalogStatus[entry.status] ?? entry.status;
        return (
          <article class="dossier-catalog-card">
            <div class="card-topline"><span>{status}</span><span>{entry.reading_depth}</span></div>
            <h3>{entry.title[lang]}</h3>
            <p>{entry.description[lang]}</p>
            <a class="text-link" href={href}>{copy.catalogAction} <span aria-hidden="true">?</span></a>
          </article>
        );
      })}
    </div>
  </section>

  <section class="evidence-principles-section" aria-labelledby="principles-title">
    <div class="section-heading">
      <p class="eyebrow">{copy.rulesEyebrow}</p>
      <h2 id="principles-title">{copy.rulesTitle}</h2>
    </div>
    <div class="principles-grid">
      {copy.rules.map((rule) => (
        <article class="principle-card">
          <h3>{rule.title}</h3>
          <p>{rule.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="product-action-section" aria-labelledby="action-title">
    <div>
      <p class="eyebrow">{isUrdu ? "???? ???" : "The next step"}</p>
      <h2 id="action-title">{copy.finalTitle}</h2>
      <p>{copy.finalBody}</p>
    </div>
    <a class="button button-dark" href={`/${lang}/learn`}>{copy.finalAction} <span aria-hidden="true">?</span></a>
  </section>
</AtlasLayout>
