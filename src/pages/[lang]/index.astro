      panelBody: "?????? ??? ?? ??? ??? ??????? ?????? ?????? ????? ?????? ??? ???? ?????? ?????? ?? ?????",
      waysEyebrow: "???? ???? ?? ???? ???",
      waysTitle: "??? ?? ????? ??? ?????? ??????",
      waysLead: "?? ??? ?? ???? ?? ???? ?????? ???? ??? ??? ??? ?? ?? ?? ?? ?? ??? ?? ??? ????",
      intents: [
        { title: "??????", body: "??? ????? ??????? ???? ??? ??? ?? ??? ??? ??????", href: `/${lang}/learn`, action: "Story Canvas" },
        { title: "???????", body: "????? ?????? ?? ??? ????? ????? ??? ?? ???? ???????", href: `/${lang}/teach`, action: "Teacher Studio" },
        { title: "????? ????", body: "?????? ????? ????? ??? ???? ?? ???? ?? ??? ??? ?? ??????", href: `/${lang}/research`, action: "Evidence Desk" },
      ],
      storyEyebrow: "?????? ???",
      storyTitle: "???? ?? ??? ???? ??? ???????",
      storyLead: "?? ????? ????? ?? ???? ????? ?? ????? ???? ???? ???? ?????? ????? ???? ????? ???? ???? ???? ????? ??? ??? ??? ?? ??? ???? ???",
      openStory: "?????? ????? ??????",
      anchors: "????? ?????",
      rulesEyebrow: "????? ?? ?????",
      rulesTitle: "???? ?? ???? ????? ???? ?????",
      rules: [
        { title: "????", body: "??? ?? ????? ???? ??? ?????? ??? ???" },
        { title: "?????", body: "????? ????? ?? ????? ?? ????? ???? ???? ??? ???? ?? ???? ??? ???" },
        { title: "???????", body: "?? ???? ?? ???? ???? ????? ?? ?? ????? ????? ??? ??? ???? ???? ?????" },
      ],
      finalTitle: "???? ???: ?????? ???????",
      finalBody: "?? ???? ??? dossier ??? ??? ?? ?? ??? ledger ???? ????",
      finalAction: "?????? ???? ????",
      catalogEyebrow: "??????? ??????",
      catalogTitle: "??? atlas? ??? ??????? ??????",
      catalogLead: "??? ?????? ???? ????? ?????? ?? ???? ??? ??? ?????? ??? ?????? ????? ??? ????? ?? ??? ???? ??? ???",
      catalogStatus: { "product-slice-foundation": "???? product slice", "quran-anchor-only": "??? ????? ?????" },
      catalogAction: "?????? ??????",
    }
  : {
      eyebrow: "QURANIC NARRATIVE ATLAS",
      heading: "Read the story. Keep the source in view.",
      lead: "A place to learn, teach, and research Quranic narratives ? with Quran anchors, reported material, and unknowns kept visibly apart.",
      learn: "Begin the story",
      research: "Open the evidence desk",
      panelKicker: "The first reading",
      panelBody: "A first Story Canvas for the Companions of the Cave, built around Quran anchors and an open verification record.",
      waysEyebrow: "Enter with intent",
      waysTitle: "One body of material. Three useful ways in.",
      waysLead: "The source relationship stays intact; the surface changes with the work you came to do.",
      intents: [
        { title: "Learn", body: "Move through a paced story spine, passage by passage.", href: `/${lang}/learn`, action: "Story Canvas" },
        { title: "Teach", body: "Compose a simple, local lesson outline from Quran anchors.", href: `/${lang}/teach`, action: "Teacher Studio" },
        { title: "Research", body: "Keep claim, source, tradition, and verification state on one desk.", href: `/${lang}/research`, action: "Evidence Desk" },
      ],
      storyEyebrow: "ASHAB AL-KAHF",
      storyTitle: "A story held close to the page.",
      storyLead: "Six Quran anchors structure this first canvas. Where a tafsir claim has not been checked, the canvas says so and keeps the prose withheld.",
      openStory: "Open the Story Canvas",
      anchors: "Quran anchor",
