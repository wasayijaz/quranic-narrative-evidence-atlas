---
import AtlasLayout from "../../layouts/AtlasLayout.astro";
import { loadAtlas } from "../../lib/atlas";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ur" } }];
}

const lang = Astro.params.lang === "ur" ? "ur" : "en";
const isUrdu = lang === "ur";
const atlas = await loadAtlas("ashab-al-kahf");
const dossier = atlas.dossiers.find((entry) => entry.id === "ashab-al-kahf") ?? {
  title: { en: "The Companions of the Cave", ur: "?????? ???" },
  description: { en: "", ur: "" },
};
const disclosure = dossier.disclosure?.[lang] ?? (isUrdu
  ? "?? ???? ?? ??? ???? ???? ?? ???? ?????? ??????? ????? ??? ?? ??? ?? ???? ????"
  : "Not reviewed by a scholarly board. Corrections are logged publicly.");
const laneLabels = isUrdu
  ? { quran: "????? ?????", reported: "????? ????", unknown: "???????" }
  : { quran: "Quran anchor", reported: "Reported material", unknown: "Unknown" };
const statusLabels = isUrdu
  ? { "quran-linked": "???? ?? ?????", candidate: "???????", unknown: "???????" }
  : { "quran-linked": "Quran-linked", candidate: "Candidate", unknown: "Unknown" };
const copy = isUrdu
  ? {
      eyebrow: "?????? ? ?????? ?????",
      title: "?????? ???? ????? ?? ?????",
      lead: "?? ????? ?????? ?? ????? ?????? ?? ???? ????? ???? ??? ?????? ????? ??? ????? ??? ?? ???? ??? ?? ?? ?? ?? ???? ????? ?? ?????",
      research: "????? ??? ??????",
      quran: "???? ?? ????? ??????",
      spine: "??????? ?????",
      evidence: "?? ??? ?? ????",
      atlasLink: "????? ?????",
      open: "????? ?????? ??????",
      sourceNote: "????? ????? ??? ?????? ????? ??? ?? ??? ???? ????",
      withheld: "?? ????? ???? ??? ??? ??? ???",
      withheldBody: "???? ledger row ??? located: no ??? ?? ??? ???? ?? ??? ??? ???? ???? ?? ????",
      closing: "????? ?? ???? ???? ??? ???? ??????",
      closingBody: "???? ???: ??? ??? beat ?? ???? ?? ??? ????? ??????? ??? ????? ?????? ???????",
      closeAction: "????? ?? ??? ?????",
    }
  : {
      eyebrow: "LEARN ? STORY CANVAS",
      title: "The Companions of the Cave, passage by passage",
      lead: "This canvas sequences the narrative through Quran anchors. Tafsir claims stay on the evidence desk until their source pages are checked.",
      research: "Open the evidence desk",
      quran: "View the Quran anchors",
      spine: "Story spine",
      evidence: "Evidence for this beat",
      atlasLink: "Atlas anchor",
      open: "Open source record",
      sourceNote: "A Quran anchor and a tafsir claim are not the same thing.",
      withheld: "This claim is still withheld.",
      withheldBody: "Its active ledger row is marked located: no, so the claim's prose is not published.",
      closing: "Keep the source open with the story.",
      closingBody: "Next: open a Quran passage from any beat, then inspect the evidence record beside it.",
      closeAction: "Continue to research",
    };
---

<AtlasLayout
  lang={lang}
  title={isUrdu ? "?????? ????? ? ?????? ???" : "Story Canvas ? Ashab al-Kahf"}
  description={dossier.description[lang]}
  current="learn"
  disclosure={disclosure}
  disclosureLinkLabel={isUrdu ? "????? ???? ?? ??????" : "Public verification ledger"}
>
  <section class="canvas-hero">
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="hero-lead">{copy.lead}</p>
      <div class="hero-actions">
        <a class="button button-dark" href={`/${lang}/research`}>{copy.research}</a>
        <a class="text-link" href={`/${lang}/quran`}>{copy.quran} <span aria-hidden="true">?</span></a>
      </div>
    </div>
    <aside class="canvas-index" aria-label={isUrdu ? "????? ?????" : "Anchor summary"}>
      <span class="canvas-index-label">{isUrdu ? "????? ????? ???" : "Quran anchors"}</span>
      <strong>{String(atlas.beats.length).padStart(2, "0")}</strong>
      <span>{isUrdu ? "?? ????? ?? ???" : "beats in this canvas"}</span>
    </aside>
  </section>

  <section class="story-canvas-section" aria-labelledby="story-spine-title">
    <aside class="story-outline">
      <p class="eyebrow">{copy.spine}</p>
      <h2 id="story-spine-title">{isUrdu ? "??? ??? ??? ?????" : "The route at a glance"}</h2>
      <nav aria-label={isUrdu ? "??????? ????" : "Story beats"}>
        <ol>
          {atlas.beats.map((beat) => (
            <li><a href={`#${beat.id}`}><span>{String(beat.order).padStart(2, "0")}</span>{beat.title[lang]}</a></li>
          ))}
        </ol>
      </nav>
    </aside>

    <div class="story-beat-list">
      {atlas.beats.map((beat) => (
        <article class="story-beat" id={beat.id} data-beat={beat.id}>
          <div class="story-beat-heading">
            <span class="story-beat-number">{String(beat.order).padStart(2, "0")}</span>
            <div>
              <p class="eyebrow">{laneLabels[beat.evidence_lane]}</p>
              <h2>{beat.title[lang]}</h2>
            </div>
          </div>
          <p class="story-beat-summary">{beat.summary[lang]}</p>
          <div class="story-beat-footer">
            <div class="ayah-links" aria-label={isUrdu ? "????? ?????" : "Quran passage references"}>
              <span>{isUrdu ? "????" : "Quran"}</span>
              <a href={beat.quran_link} rel="noreferrer" target="_blank"><bdi>{beat.ayah_refs.join(" ? ")}</bdi> <span aria-hidden="true">?</span></a>
              <a href={`/${lang}/quran#${beat.id}`}>{copy.atlasLink} <span aria-hidden="true">?</span></a>
            </div>
            <div class="beat-status">
              <span>{statusLabels[beat.status]}</span>
              {beat.claim_ids.length > 0 && <a href={`/${lang}/research#${beat.claim_ids[0]}`}>{copy.evidence}</a>}
            </div>
          </div>
          {beat.claim_ids.length > 0 && (
            <div class="story-beat-note">
              <strong>{copy.withheld}</strong>
              <p>{copy.withheldBody}</p>
              <a class="text-link" href={`/${lang}/research#${beat.claim_ids[0]}`}>{copy.open} <span aria-hidden="true">?</span></a>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="canvas-closing-section" aria-labelledby="canvas-closing-title">
    <div>
      <p class="eyebrow">{copy.sourceNote}</p>
      <h2 id="canvas-closing-title">{copy.closing}</h2>
      <p>{copy.closingBody}</p>
    </div>
    <a class="button button-dark" href={`/${lang}/research`}>{copy.closeAction} <span aria-hidden="true">?</span></a>
  </section>
</AtlasLayout>
