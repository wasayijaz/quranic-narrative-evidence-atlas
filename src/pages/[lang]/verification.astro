---
import AtlasLayout from "../../layouts/AtlasLayout.astro";
import { loadAtlas } from "../../lib/atlas";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ur" } }];
}

const lang = Astro.params.lang === "ur" ? "ur" : "en";
const isUrdu = lang === "ur";
const atlas = await loadAtlas("ashab-al-kahf");
const dossier = atlas.dossiers.find((entry) => entry.id === "ashab-al-kahf");
const disclosure = dossier?.disclosure?.[lang] ?? (isUrdu
  ? "اس مواد کو کسی علمی بورڈ نے نہیں پرکھا۔ اصلاحات عوامی طور پر درج کی جاتی ہیں۔"
  : "Not reviewed by a scholarly board. Corrections are logged publicly.");
const copy = isUrdu
  ? {
      title: "ہر خلا دکھائی دیتا ہے۔",
      lead: "یہ ریکارڈ شائع شدہ دعووں کے ساتھ ان دعووں کو بھی دکھاتا ہے جو ابھی جانچ کے منتظر ہیں۔",
      total: "کل دعوے",
      verified: "واقع",
      secondary: "ثانوی",
      unlocated: "غیر واقع",
      blocked: "روکے گئے",
      parity: "تکمیلی فرق",
      ledger: "توثیقی قطار",
      withheld: "یہ دعویٰ روک دیا گیا ہے",
      source: "ماخذ",
      sourceClass: "ماخذ کی قسم",
      status: "دعویٰ کی حیثیت",
      verification: "جانچ کی حالت",
      tradition: "روایتی ماخذ",
      sunni: "سنی ماخذ",
      shia: "شیعی ماخذ",
      missing: "اس دعوے کے لیے درج نہیں",
      notes: "نوٹس",
      back: "مطالعے پر واپس جائیں",
      disclosureLink: "اصلاحی ریکارڈ",
      explanation: "located: no کا مطلب ہے کہ دعویٰ موجود ہے، مگر ابھی اشاعت کے لیے اہل نہیں۔ تکمیلی فرق وہ دعوے ہیں جن کے لیے سنی اور شیعی دونوں طرف ماخذ درج نہیں۔",
      withheldBody: "اصل بیان اس وقت تک نہیں دکھایا جائے گا جب تک ماخذ کا صفحہ جانچ نہ لیا جائے۔",
      publishedBody: "یہ بیان فعال توثیقی قطار مکمل ہونے کی وجہ سے عوامی متن میں شامل ہے۔",
      unknown: "نامعلوم",
    }
  : {
      title: "Every gap stays visible.",
      lead: "This ledger shows the published record and the claims still waiting for a human check.",
      total: "Total claims",
      verified: "Located",
      secondary: "Secondary",
      unlocated: "Unlocated",
      blocked: "Blocked",
      parity: "Parity gaps",
      ledger: "Verification ledger",
      withheld: "This claim is withheld",
      source: "Source",
      sourceClass: "Source class",
      status: "Claim status",
      verification: "Verification state",
      tradition: "Tradition lanes",
      sunni: "Sunni source",
      shia: "Shia source",
      missing: "Not recorded for this claim",
      notes: "Notes",
      back: "Return to the reading",
      disclosureLink: "Public correction log",
      explanation: "located: no means the claim exists in the working record but is not eligible for publication yet. A parity gap is a claim without both Sunni and Shia source lanes.",
      withheldBody: "The statement stays out of the reading until its source page is checked.",
      publishedBody: "This statement appears because its active verification rows are complete.",
      unknown: "Unknown",
    };

const metricCards = [
  { label: copy.total, value: atlas.summary.total, className: "metric-dark" },
  { label: copy.verified, value: atlas.summary.verified, className: "metric-green" },
  { label: copy.secondary, value: atlas.summary.secondary, className: "metric-blue" },
  { label: copy.unlocated, value: atlas.summary.unlocated, className: "metric-amber" },
  { label: copy.blocked, value: atlas.summary.blocked, className: "metric-red" },
  { label: copy.parity, value: atlas.summary.parityGaps, className: "metric-slate" },
];

const sourceClassLabels = isUrdu
  ? { quran: "قرآن", hadith: "حدیث", tafsir: "تفسیر", history: "تاریخ", academic: "علمی" }
  : { quran: "Quran", hadith: "Hadith", tafsir: "Tafsir", history: "History", academic: "Academic" };
const statusLabels = isUrdu
  ? { attested: "منقول", disputed: "متنازع", "reported-only": "صرف منقول رپورٹ", rejected: "مسترد" }
  : { attested: "Attested", disputed: "Disputed", "reported-only": "Reported only", rejected: "Rejected" };
const stateLabels = isUrdu
  ? { verified: "واقع", secondary: "ثانوی", unlocated: "غیر واقع", blocked: "روکے گئے" }
  : { verified: "Located", secondary: "Secondary", unlocated: "Unlocated", blocked: "Blocked" };

function labelFor(labels: Record<string, string>, value: string | undefined) {
  return value ? labels[value] ?? value : copy.unknown;
}

const ledgerCards = atlas.gateResults.map((result) => {
  const claim = atlas.claims.find((candidate) => candidate.id === result.claimId);
  const rows = atlas.ledgerRows.filter((row) => row.claim === result.claimId && !row.superseded_by);
  const attributions = claim?.attributions ?? [];
  const lanes = {
    sunni: attributions.filter((attribution) => attribution.tradition === "sunni").map((attribution) => ({
      label: atlas.sources.find((source) => source.id === attribution.source)?.work_title_en ?? attribution.source,
      edition: attribution.edition,
      page: attribution.page,
    })),
    shia: attributions.filter((attribution) => attribution.tradition === "shia").map((attribution) => ({
      label: atlas.sources.find((source) => source.id === attribution.source)?.work_title_en ?? attribution.source,
      edition: attribution.edition,
      page: attribution.page,
    })),
  };

  return { result, claim, rows, lanes };
});
---

<AtlasLayout
  lang={lang}
  title={isUrdu ? "توثیقی ریکارڈ" : "Verification ledger"}
  description={isUrdu ? "قرآنی بیانیہ ایٹلس کا عوامی توثیقی ریکارڈ۔" : "The public verification ledger for the Quranic Evidence Atlas."}
  current="verification"
  disclosure={disclosure}
  disclosureLinkLabel={copy.disclosureLink}
>
  <section class="verification-hero">
    <div>
      <p class="eyebrow">{isUrdu ? "عوامی ریکارڈ" : "PUBLIC LEDGER"}</p>
      <h1>{copy.title}</h1>
      <p class="hero-lead">{copy.lead}</p>
    </div>
    <a class="button button-dark" href={`/${lang}/ashab-al-kahf`}>{copy.back}</a>
  </section>

  <section class="metrics-grid" aria-label={isUrdu ? "توثیقی اعداد" : "Verification counts"}>
    {metricCards.map((metric) => (
      <article class:list={["metric-card", metric.className]}>
        <span>{metric.label}</span>
        <strong>{metric.value}</strong>
      </article>
    ))}
  </section>

  <section class="ledger-section" aria-labelledby="ledger-title">
    <div class="section-heading compact-heading">
      <p class="eyebrow">{copy.ledger}</p>
      <h2 id="ledger-title">{isUrdu ? "دعوے کی حالت، ماخذ کے ساتھ" : "Claim state, kept beside the source."}</h2>
      <p>{copy.explanation}</p>
    </div>

    <div class="ledger-list">
      {ledgerCards.map(({ result, claim, rows, lanes }) => (
        <article class:list={["ledger-row", result.publishable ? "claim-published" : "claim-withheld"]}>
          <div class="ledger-status" data-state={result.state}>
            <span class="status-dot" aria-hidden="true"></span>
            <span>{stateLabels[result.state]}</span>
          </div>
          <div class="ledger-main">
            <p class="claim-id"><bdi>{result.claimId}</bdi></p>
            <h3>{result.publishable ? (claim?.statement?.[lang] ?? copy.unknown) : copy.withheld}</h3>
            <dl class="claim-facts">
              <div>
                <dt>{copy.sourceClass}</dt>
                <dd>{labelFor(sourceClassLabels, claim?.source_class)}</dd>
              </div>
              <div>
                <dt>{copy.status}</dt>
                <dd>{labelFor(statusLabels, claim?.status)}</dd>
              </div>
              <div>
                <dt>{copy.verification}</dt>
                <dd>{stateLabels[result.state]}</dd>
              </div>
            </dl>
            <p>{result.publishable ? copy.publishedBody : copy.withheldBody}</p>
          </div>
          <div class="ledger-source">
            <span>{copy.source}</span>
            {rows.map((row) => (
              <div class="source-record">
                <p><bdi>{row.source}</bdi> · <bdi>{row.edition}</bdi></p>
                <small>{row.notes}</small>
              </div>
            ))}
            <div class="tradition-lanes" aria-label={copy.tradition}>
              <div class="tradition-lane">
                <span>{copy.sunni}</span>
                {lanes.sunni.length > 0 ? lanes.sunni.map((lane) => (
                  <p><bdi>{lane.label}</bdi> · <bdi>{lane.edition}</bdi>{lane.page ? ` · ${isUrdu ? "صفحہ" : "page"} ${lane.page}` : ""}</p>
                )) : <p class="lane-empty">{copy.missing}</p>}
              </div>
              <div class="tradition-lane">
                <span>{copy.shia}</span>
                {lanes.shia.length > 0 ? lanes.shia.map((lane) => (
                  <p><bdi>{lane.label}</bdi> · <bdi>{lane.edition}</bdi>{lane.page ? ` · ${isUrdu ? "صفحہ" : "page"} ${lane.page}` : ""}</p>
                )) : <p class="lane-empty">{copy.missing}</p>}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="correction-section" aria-labelledby="correction-title">
    <div class="section-heading compact-heading">
      <p class="eyebrow">{isUrdu ? "اصلاحی ریکارڈ" : "Correction log"}</p>
      <h2 id="correction-title">{isUrdu ? "پرانے قطاریں محفوظ رہتی ہیں" : "Old rows stay visible."}</h2>
      <p>{isUrdu ? "درستگی کسی پرانی قطار کو مٹاتی نہیں؛ نئی قطار اسے بدلتی ہے اور وجہ یہاں رہتی ہے۔" : "A correction never deletes the old row. A new row supersedes it, while the reason remains visible here."}</p>
    </div>
    <div class="correction-list">
      {atlas.corrections.length === 0 ? (
        <p class="empty-correction">{isUrdu ? "ابھی کوئی اصلاح درج نہیں۔" : "No corrections recorded yet."}</p>
      ) : (
        atlas.corrections.map((row) => (
          <article class="correction-row">
            <p><bdi>{row.claim}</bdi> · <bdi>{row.source}</bdi></p>
            <p>{row.notes}</p>
            <small>{isUrdu ? "نئی قطار:" : "Superseded by:"} <bdi>{row.superseded_by}</bdi></small>
          </article>
        ))
      )}
    </div>
  </section>
</AtlasLayout>
