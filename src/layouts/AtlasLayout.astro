---
import "../styles/atlas.css";

interface Props {
  lang: "en" | "ur";
  title: string;
  description: string;
  current: "explore" | "quran" | "learn" | "teach" | "research" | "dossier" | "verification";
  disclosure?: string;
  disclosureLinkLabel?: string;
  languageHrefOverride?: string;
}

const { lang, title, description, current, disclosure, disclosureLinkLabel, languageHrefOverride } = Astro.props;
const isUrdu = lang === "ur";
const otherLang = isUrdu ? "en" : "ur";
const routePaths = {
  explore: "",
  quran: "quran",
  learn: "learn",
  teach: "teach",
  research: "research",
  dossier: "ashab-al-kahf",
  verification: "verification",
} as const;
const dossierHref = `/${lang}/ashab-al-kahf`;
const verificationHref = `/${lang}/verification`;
const languagePath = routePaths[current];
const languageHref = languageHrefOverride ?? `/${otherLang}${languagePath ? `/${languagePath}` : ""}`;
const navigation = [
  { key: "explore", href: `/${lang}`, en: "Explore", ur: "??????" },
  { key: "quran", href: `/${lang}/quran`, en: "Quran", ur: "????" },
  { key: "learn", href: `/${lang}/learn`, en: "Learn", ur: "??????" },
  { key: "teach", href: `/${lang}/teach`, en: "Teach", ur: "???????" },
  { key: "research", href: `/${lang}/research`, en: "Research", ur: "?????" },
];
---

<!doctype html>
<html lang={lang} dir={isUrdu ? "rtl" : "ltr"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} ? Quranic Evidence Atlas</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-nav" aria-label={isUrdu ? "?????? ????????" : "Primary navigation"}>
        <a class="brand" href={`/${lang}`} aria-label={isUrdu ? "????? ?????? ?????" : "Quranic Narrative Atlas"}>
          <span class="brand-mark" aria-hidden="true">?</span>
          <span>Quranic<br /><em>Evidence Atlas</em></span>
        </a>
        <nav class="nav-links" aria-label={isUrdu ? "?????" : "Pages"}>
          {navigation.map((link) => (
            <a class:list={{ active: current === link.key }} href={link.href}>{isUrdu ? link.ur : link.en}</a>
          ))}
          <a class:list={{ active: current === "verification" }} href={verificationHref}>{isUrdu ? "????" : "Verification"}</a>
          <a class="language-link" href={languageHref} lang={otherLang} dir={otherLang === "ur" ? "rtl" : "ltr"}>
            {isUrdu ? "English" : "????"}
          </a>
        </nav>
      </header>

      <main>
        {disclosure && (
          <aside class="resource-disclosure" aria-label={isUrdu ? "????? ?????" : "Resource disclosure"}>
            <p>{disclosure}</p>
            {disclosureLinkLabel && <a href={verificationHref}>{disclosureLinkLabel}</a>}
          </aside>
        )}
        <slot />
      </main>

      <footer class="site-footer">
        <div>
          <p class="footer-title">Quranic Evidence Atlas</p>
          <p class="footer-note">{isUrdu ? "?? ?????? ???? ???? ?? ?????" : "Every claim, held close to its source."}</p>
        </div>
        <div class="footer-links">
          <a href={`/${lang}/learn`}>{isUrdu ? "?????? ?? ??????" : "Story canvas"}</a>
          <a href={`/${lang}/research`}>{isUrdu ? "????? ???" : "Evidence desk"}</a>
          <a href={verificationHref}>{isUrdu ? "????? ???? ?? ??????" : "Public verification ledger"}</a>
        </div>
      </footer>
    </div>
  </body>
</html>
